# ==============================================================================
# SISTEM INFORMASI KOPERASI SIMPAN PINJAM AHNRFZI
# Environment Configuration Template
# ==============================================================================

# Application Configuration
APP_NAME="KSP AHNRFZI - Sistem Informasi Koperasi Simpan Pinjam"
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY="ksp-ahnrfzi-super-secret-key-change-in-production-2026"

# Database Configuration
# Default: SQLite (WAL mode enabled)
DATABASE_URL=sqlite:///./koperasi_ahnrfzi.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://ksp_user:ksp_password@localhost:5432/ksp_ahnrfzi

# Security & JWT Authentication
JWT_SECRET_KEY="ksp-ahnrfzi-jwt-secret-token-key-2026"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Audit Logging & Compliance
ENABLE_AUDIT_LOG=true

# AI Assistant Integration (Rule-based default, ready for OpenAI / Gemini)
# rule_engine = jawaban pola lokal (tanpa key).
# openai      = endpoint kompatibel OpenAI Chat Completions
#               (OpenAI / DeepSeek / Groq / OpenRouter / gateway lain).
AI_PROVIDER=rule_engine
AI_API_KEY=""
AI_MODEL_NAME="gpt-4o-mini"
AI_BASE_URL="https://api.openai.com/v1"
