# ==============================================================================
# KSP AHNRFZI - Environment Configuration Template (.env.example)
# Salin file ini menjadi .env dan isi nilai yang sesuai untuk lingkungan Anda.
# JANGAN PERNAH commit file .env yang berisi credential riil ke version control.
# ==============================================================================

# 1. Aplikasi Umum
APP_NAME=KSP AHNRFZI - Sistem Informasi Koperasi Simpan Pinjam
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=ksp-ahnrfzi-super-secret-key-change-in-production-2026

# 2. Database (SQLite default di local workspace)
DATABASE_URL=sqlite:///koperasi_ahnrfzi.db

# 3. Keamanan JWT
JWT_SECRET_KEY=ksp-ahnrfzi-jwt-secret-token-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 4. Telegram Bot API Integration (Notifikasi Multi-Channel)
# Buat bot via @BotFather di Telegram untuk mendapatkan TOKEN dan USERNAME
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secret token untuk validasi header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# URL Webhook HTTPS publik (misal via Cloudflare Tunnel / Reverse Proxy / Domain Resmi)
TELEGRAM_WEBHOOK_URL=

# 5. AI Assistant Chatbot
# rule_engine = pola internal offline; openai = LLM eksternal
AI_PROVIDER=rule_engine
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30

# 6. Notifikasi Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KSP AHNRFZI <noreply@example.coop>
SMTP_USE_TLS=true
